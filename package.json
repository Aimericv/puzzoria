{
  "name": "puzzoria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/check-build-traces.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "content:generate": "tsx scripts/generate-content.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:social": "tsx scripts/validate-social-content.ts",
    "seo:check": "tsx scripts/check-seo.ts",
    "docker:smoke": "node --import tsx scripts/test-docker.mjs",
    "test:load": "node --import tsx scripts/test-docker.mjs --load",
    "release:check": "node --env-file-if-exists=.env.docker --import tsx scripts/check-release.ts",
    "release:public": "tsx scripts/check-public-site.ts",
    "dictionary:import:fr": "tsx scripts/import-french-dictionary.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.3"
  }
}
