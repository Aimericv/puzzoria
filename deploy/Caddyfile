# Template for Caddy installed on the VPS host, directly exposed to clients.
# Set SITE_DOMAIN to the bare purchased domain before validating/loading this file.
# Public launch: do not retain an IP allowlist, preparation 503 response, or
# global X-Robots-Tag noindex. The application controls private-page noindex.
{$SITE_DOMAIN} {
  reverse_proxy 127.0.0.1:3030 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto https
  }
}

www.{$SITE_DOMAIN} {
  redir https://{$SITE_DOMAIN}{uri} permanent
}
