NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Replace with the final public HTTPS domain before launch, then rebuild.
# Local/placeholder origins automatically keep pages in noindex. Run npm run seo:check.
# Node 24.15+; absolute private path on a persistent volume in production.
# DAILYGRID_DB_PATH=C:/GameAD/.data/dailygrid.sqlite
# Production error monitoring also requires this explicit private database path.
# Exact HTTPS frontend origin in production. Unset locally to accept the request Host.
# AUTH_ORIGIN=https://your-domain.example
# Enable only when your trusted reverse proxy overwrites X-Forwarded-For.
# Enables per-IP signup caps (5/hour, 20/day); otherwise a shared cap applies.
TRUST_PROXY=false
# Private internal dashboard: immutable login usernames of EXISTING administrator accounts.
# No administrators are enabled by default. Never configure a not-yet-registered username.
# ANALYTICS_ADMIN_USERNAMES=your_existing_username
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_COUNTRY=
LEGAL_CONTACT_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_STORAGE_REGION=
